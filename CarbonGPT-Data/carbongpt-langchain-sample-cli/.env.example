# Tool-calling chat model (Flowise "ChatOpenAI Custom" node -> vLLM OpenAI-compatible endpoint)
VLLM_BASE_URL=https://vllm.datacrystals.net/v1/
VLLM_MODEL=/data/ModelDownloader/MiniMax-M2.7-AWQ-4bit/
VLLM_API_KEY=not-needed
VLLM_TEMPERATURE=0.6

# LocalAI-compatible embeddings server used by both retriever tools
EMBEDDINGS_BASE_URL=http://localhost:8082/v1
EMBEDDINGS_MODEL=embeddinggemma
EMBEDDINGS_API_KEY=not-needed

# Chroma vector store
CHROMA_URL=http://localhost:8000

# "braingenix-documents" retriever tool
BRAINGENIX_COLLECTION=BrainGenix
BRAINGENIX_TOP_K=20

# "research-documents" retriever tool
RESEARCH_COLLECTION=ResearchDocuments
RESEARCH_TOP_K=6
