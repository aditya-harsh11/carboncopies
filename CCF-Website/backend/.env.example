# backend/.env — copy to backend/.env and fill in. NEVER commit the real file
# (backend/.env is gitignored). This .env.example IS committed as the template.

# --- Google OAuth client -----------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Application type: Web application). Consent screen must be "Internal".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must EXACTLY match an "Authorized redirect URI" on the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# Only Google Workspace accounts on this domain may sign in.
ALLOWED_DOMAIN=carboncopies.org

# Where to send users after logout (the public site home). "/" in prod (same
# domain); for local dev the MkDocs site is http://localhost:9000/.
SITE_URL=/

# --- Sessions ----------------------------------------------------------------
# Signing key for the transient OAuth-state cookie. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS=28800

# true in production (HTTPS) so cookies are Secure-only; false for http dev.
COOKIE_SECURE=false

# --- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API with credentials (the site).
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
